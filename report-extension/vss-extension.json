{
  "manifestVersion": 1,
  "id": "performance-quality-report",
  "name": "Performance Quality Report",
  "version": "1.0.3",
  "scopes": [
    "vso.build",
    "vso.release"
  ],
  "publisher": "cristianca23",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "description": "Publica un HTML y lo muestra en la pestaña Reports de la etapa.",
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "images/documento.png"
  },
  "files": [
    {
      "path": "images/documento.png",
      "addressable": true
    },
    {
      "path": "tab",
      "addressable": true
    },
    {
      "path": "task"
    }
  ],
  "contributions": [
    {
      "id": "publish-html-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "task"
      }
    },
    {
      "id": "release-reports-tab",
      "type": "ms.vss-web.tab",
      "targets": [
        "ms.vss-releaseManagement-web.release-environment-editor-tab"
      ],
      "includes": [
        "ms.vss-tfs-web.tfs-page-data-service",
        "ms.vss-features.host-navigation-service",
        "ms.vss-features.extension-data-service",
        "ms.vss-features.host-dialog-service"
      ],
      "properties": {
        "name": "Reports",
        "uri": "tab/index.html",
        "registeredObjectId": "registeredEnvironmentObject",
        "dynamic": true,
        "order": 1000
      }
    }
  ]
}
